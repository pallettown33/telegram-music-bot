# https://my.telegram.org/apps 에서 발급
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace_with_api_hash

# @BotFather 에서 발급. 실제 값은 절대 저장소에 커밋하지 마세요.
TELEGRAM_BOT_TOKEN=123456:replace_with_bot_token

# 음악 재생 전용 Telegram 사용자 계정의 StringSession 값
# 이미 생성된 .session 파일이 있다면 아래 줄은 비워도 됩니다.
ASSISTANT_SESSION=replace_with_generated_session

# StringSession 대신 로컬 .session 파일을 직접 쓸 때 사용
# ASSISTANT_SESSION_FILE=telegram_music_bot.session

# 선택: 봇이 초대 링크를 만들지 못할 때만 쓰는 예비 링크.
# 보통은 봇이 관리자이고 '사용자 초대' 권한이 있으면 재생 계정을 직접 들입니다.
# ASSISTANT_INVITE_LINK=https://t.me/+...

# 선택: YouTube 쿠키 파일 경로. 설정하지 않으면 작업 디렉터리의
# youtube_cookies.txt가 있을 때 자동으로 사용합니다.
# YOUTUBE_COOKIES_FILE=youtube_cookies.txt

# true면 그룹 관리자만 재생 제어 명령을 실행할 수 있습니다.
ADMIN_ONLY=false

# 선택: 필수 구독 채널. 설정하면 이 채널 구독자만 봇 명령/버튼을 사용할 수 있습니다.
# 공개 채널은 @username, 비공개 채널은 -100으로 시작하는 ID를 적습니다.
# 비공개 채널은 봇이 그 채널의 멤버(가능하면 관리자)여야 구독 여부를 확인할 수 있습니다.
# REQUIRED_CHANNEL=@yourchannel
# REQUIRED_CHANNEL_LINK=https://t.me/yourchannel
